<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scope this solution to the public NuGet feed only.
       Overrides any inherited private feeds (e.g. Hubtel Azure DevOps) that
       would otherwise require authentication and break restore. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
